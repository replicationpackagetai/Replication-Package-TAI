{
  "outer_setting": {
    "dataset": "HuggingFaceH4/ultrafeedback_binarized",
    "training_split": "train_sft",
    "training_percentage": 34,
    "fine_tuning_strategy": "SFT",
    "learning_rate": 2e-5,
    "epochs": 5,
    "seed": 42,
    "rounds": ["Round1", "Round2", "Round3"],
    "base_models": ["Qwen2.5-7B-Instruct", "Meta-Llama-3-8B-Instruct", "Mistral-7B-Instruct-v0.3", "gemma-7b-it"]
  },
  "peft_settings": {
    "lora": [
      {"label": "r4", "r": 4, "lora_alpha": 16, "lora_dropout": 0.1, "target_modules": ["q_proj", "v_proj"]},
      {"label": "r8", "r": 8, "lora_alpha": 16, "lora_dropout": 0.1, "target_modules": ["q_proj", "v_proj"]},
      {"label": "r16", "r": 16, "lora_alpha": 16, "lora_dropout": 0.1, "target_modules": ["q_proj", "v_proj"]}
    ],
    "ia3": [
      {"label": "q_v_down", "target_modules": ["q_proj", "v_proj", "down_proj"], "feedforward_modules": ["down_proj"]},
      {"label": "k_v_down", "target_modules": ["k_proj", "v_proj", "down_proj"], "feedforward_modules": ["down_proj"]}
    ],
    "prompt_tuning": [
      {"label": "v20", "num_virtual_tokens": 20, "prompt_tuning_init": "random"},
      {"label": "v50", "num_virtual_tokens": 50, "prompt_tuning_init": "random"},
      {"label": "v100", "num_virtual_tokens": 100, "prompt_tuning_init": "random"}
    ],
    "p_tuning": [
      {"label": "v20", "num_virtual_tokens": 20},
      {"label": "v50", "num_virtual_tokens": 50},
      {"label": "v100", "num_virtual_tokens": 100}
    ]
  }
}
